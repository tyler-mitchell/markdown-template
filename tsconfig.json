{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "paths": {
      "#arktype": ["./node_modules/arktype"],
      "markdown-template": ["./src/index.ts"]
    },
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite-plus/client"]
  },
  "include": ["src", "test", "scripts", "vite.config.ts"]
}
